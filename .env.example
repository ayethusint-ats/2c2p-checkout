# Copy to .env and fill in. .env is git-ignored; docker compose reads it automatically.

# MySQL root password (used only by the MySQL container and its health check).
MYSQL_ROOT_PASSWORD=
# Database the API uses; created on first start.
MYSQL_DATABASE=checkout
# Database user the API connects as; created on first start.
MYSQL_USER=checkout
# Password for MYSQL_USER.
MYSQL_PASSWORD=

# 2C2P sandbox merchant ID.
TWOCTWOP_MERCHANT_ID=
# 2C2P sandbox secret key (signs and verifies every 2C2P message; never commit it).
TWOCTWOP_SECRET_KEY=

# Public HTTPS URL that forwards to the API on port 8080, for 2C2P's server-to-server
# notification (e.g. run `ngrok http 8080` and paste its https URL).
PUBLIC_API_BASE_URL=
